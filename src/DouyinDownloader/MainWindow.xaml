<Window x:Class="DouyinDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DouyinDownloader.ViewModels"
        mc:Ignorable="d"
        Title="抖音无水印下载"
        Icon="Assets/app.ico"
        Width="500" Height="1000"
        MinWidth="500" MinHeight="1000"
        MaxWidth="700" MaxHeight="1300"
        Background="#111111"
        Foreground="#F4F4F4"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <Ellipse Width="10" Height="10" Fill="#FE2C55" VerticalAlignment="Center"/>
                <Ellipse Width="10" Height="10" Fill="#25F4EE" Margin="6,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="抖音无水印下载" FontSize="22" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="粘贴分享文案，解析后即可保存无水印视频或图集"
                       Foreground="#8A8A8A"
                       FontSize="13"
                       Margin="0,10,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <!-- <TextBlock Text="分享链接" Foreground="#8A8A8A" FontSize="13" Margin="0,0,0,8"/> -->
                <TextBox Text="{Binding ShareText, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="110"
                         Padding="5,5"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto"
                         IsReadOnly="{Binding IsBusy}"/>
                <Button Style="{StaticResource AccentButton}"
                        Content="解析作品"
                        Command="{Binding ParseCommand}"
                        Margin="0,5,0,0"/>
            </StackPanel>

            <Border x:Name="PreviewCard"
                    Grid.Row="1"
                    Background="#1A1A1A"
                    CornerRadius="12"
                    Margin="0,6,0,0"
                    MinHeight="220"
                    SizeChanged="OnPreviewCardSizeChanged">
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasWork, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="作品信息" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="解析成功后，标题、作者与封面会显示在这里"
                                   Foreground="#8A8A8A"
                                   FontSize="13"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Grid Visibility="{Binding HasWork, Converter={StaticResource BoolToVis}}">
                        <Border x:Name="CoverHost"
                                Background="#111"
                                ClipToBounds="True"
                                SizeChanged="OnCoverHostSizeChanged">
                            <Grid>
                                <TextBlock Text="无封面" Foreground="#8A8A8A" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding HasCover, Converter={StaticResource InverseBoolToVis}}"/>
                                <Image Source="{Binding CoverImage}" Stretch="Uniform">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasCover}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPlaybackVisible}" Value="True">
                                                    <Setter Property="Opacity" Value="0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <MediaElement x:Name="PreviewPlayer"
                                              LoadedBehavior="Manual"
                                              UnloadedBehavior="Stop"
                                              Stretch="Uniform"
                                              ScrubbingEnabled="True"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              Visibility="{Binding IsPlaybackVisible, Converter={StaticResource BoolToVis}}"
                                              MediaFailed="OnPreviewMediaFailed"
                                              MediaEnded="OnPreviewMediaEnded"
                                              MediaOpened="OnPreviewMediaOpened"/>
                                <Grid x:Name="CoverHitLayer"
                                      Background="Transparent"
                                      Cursor="Hand"
                                      Visibility="{Binding ShowPlayOverlay, Converter={StaticResource BoolToVis}}">
                                    <Grid.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding PlayPauseCommand}"/>
                                    </Grid.InputBindings>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Opacity" Value="0"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="1"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid Width="56" Height="56" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Fill="#99000000"/>
                                        <Path Data="M 22,16 L 22,40 L 40,28 Z"
                                              Fill="White"
                                              Stretch="None">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Border Width="5" Height="18" Background="White" CornerRadius="1" Margin="0,0,5,0"/>
                                            <Border Width="5" Height="18" Background="White" CornerRadius="1"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid HorizontalAlignment="Right"
                              VerticalAlignment="Stretch"
                              Panel.ZIndex="2">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Width" Value="28"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInfoExpanded}" Value="True">
                                            <Setter Property="Width" Value="258"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Border Width="230"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Stretch"
                                    CornerRadius="16,12,12,16"
                                    BorderBrush="#66FFFFFF"
                                    BorderThickness="1"
                                    ClipToBounds="True"
                                    Visibility="{Binding IsInfoExpanded, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Border CornerRadius="16,12,12,16" IsHitTestVisible="False">
                                        <Border.Background>
                                            <VisualBrush Visual="{Binding ElementName=CoverHost}"
                                                         Stretch="UniformToFill"
                                                         AlignmentX="Right"
                                                         AlignmentY="Center"/>
                                        </Border.Background>
                                        <Border.Effect>
                                            <BlurEffect Radius="40" KernelType="Gaussian"/>
                                        </Border.Effect>
                                    </Border>
                                    <Border CornerRadius="16,12,12,16" Background="#70FFFFFF" IsHitTestVisible="False"/>
                                    <Border CornerRadius="16,12,12,16" IsHitTestVisible="False">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#88FFFFFF" Offset="0"/>
                                                <GradientStop Color="#00FFFFFF" Offset="0.35"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <StackPanel Margin="12,12,10,10" VerticalAlignment="Top">
                                        <Border Background="#55FFFFFF" CornerRadius="4" Padding="10,4" HorizontalAlignment="Left" Margin="0,0,0,14">
                                            <TextBlock Text="{Binding Work.TypeLabel}" FontSize="13" Foreground="#25F4EE"/>
                                        </Border>
                                        <TextBlock Text="{Binding Work.DisplayTitle}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F5F5F5"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="52"
                                                   ToolTip="{Binding Work.DisplayTitle}"
                                                   ToolTipService.ShowDuration="20000"/>
                                        <TextBlock Margin="0,16,0,0"
                                                   Foreground="#C8C8C8"
                                                   FontSize="14"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Work.DisplayAuthor}">
                                            <Run Text="作者  "/>
                                            <Run Text="{Binding Work.DisplayAuthor, Mode=OneWay}" Foreground="#F5F5F5"/>
                                        </TextBlock>
                                        <TextBlock Margin="0,8,0,0"
                                                   Foreground="#C8C8C8"
                                                   FontSize="14"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Work.AwemeId}">
                                            <Run Text="作品  "/>
                                            <Run Text="{Binding Work.AwemeId, Mode=OneWay}" Foreground="#F5F5F5"/>
                                        </TextBlock>
                                        <StackPanel Margin="0,18,0,0" Visibility="{Binding ShowQualityOptions, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="清晰度" Foreground="#C8C8C8" FontSize="13" Margin="0,0,0,8"/>
                                            <StackPanel>
                                                <RadioButton GroupName="Quality" Content="1080p" Foreground="#F5F5F5"
                                                             IsChecked="{Binding SelectedQuality, Converter={StaticResource StringEquals}, ConverterParameter=1080p}"/>
                                                <RadioButton GroupName="Quality" Content="720p" Foreground="#F5F5F5"
                                                             IsChecked="{Binding SelectedQuality, Converter={StaticResource StringEquals}, ConverterParameter=720p}"/>
                                                <RadioButton GroupName="Quality" Content="540p" Foreground="#F5F5F5"
                                                             IsChecked="{Binding SelectedQuality, Converter={StaticResource StringEquals}, ConverterParameter=540p}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ToggleButton Style="{StaticResource InfoToggle}"
                                          IsChecked="{Binding IsInfoExpanded}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Stretch"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,14,0,0">
                <TextBlock Text="保存位置" Foreground="#8A8A8A" FontSize="13" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding SaveDirectory, UpdateSourceTrigger=PropertyChanged}"
                             Height="44"
                             Padding="4,0"
                             VerticalContentAlignment="Center"
                             TextWrapping="NoWrap"
                             AcceptsReturn="False"
                             ToolTip="{Binding SaveDirectory}"/>
                    <Button Grid.Column="2" Content="选择目录" Command="{Binding BrowseFolderCommand}"/>
                </Grid>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <Button Style="{StaticResource AccentButton}"
                    Content="下载"
                    Command="{Binding DownloadCommand}"
                    Height="48"
                    FontSize="16"/>
            <ProgressBar Margin="0,6,0,0"
                         Minimum="0" Maximum="100"
                         Value="{Binding ProgressValue}"
                         IsIndeterminate="{Binding ProgressIsIndeterminate}"/>
            <DockPanel Margin="0,14,0,0">
                <Button DockPanel.Dock="Right" Content="打开目录" Command="{Binding OpenFolderCommand}" Height="40" MinWidth="100"/>
                <TextBlock Text="{Binding StatusText}"
                           TextWrapping="Wrap"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#8A8A8A"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="#FF6B81"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
